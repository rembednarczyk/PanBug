@if (!string.IsNullOrEmpty(Text))
{
    <div class="alert @(Error ? "alert-error" : "alert-info")" role="@(Error ? "alert" : "status")">
        <Icon Name="@(Error ? "circle-alert" : "info")" Size="16" /><span>@Text</span>
    </div>
}

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public bool Error { get; set; } = true;
}
