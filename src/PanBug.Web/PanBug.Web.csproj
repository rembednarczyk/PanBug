<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <RootNamespace>PanBug.Web</RootNamespace>
    <AssemblyName>PanBug.Web</AssemblyName>
    <!-- Polska kultura (przecinek dziesiętny, "zł") niezależnie od języka przeglądarki. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PanBug.Domain/PanBug.Domain.csproj" />
  </ItemGroup>
</Project>
